{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "app",
    "rootDir": "src",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "useDefineForClassFields": true,
    "allowJs": true
  },
  "include": [
    "src/**/*"
  ]
}
